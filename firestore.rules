rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ((request.auth.token.email == 'titangaming4m@gmail.com' || request.auth.token.email == 'titangaming5m@gmail.com' || request.auth.token.email == 'sanjeevidaa16@gmail.com') && request.auth.token.email_verified == true)
      );
    }

    // Users collection
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if isSignedIn();
    }

    // Videos collection
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Playlists collection
    match /playlists/{playlistId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Watch Progress collection
    match /watch_progress/{progressId} {
      allow get, list, create, update, delete: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Sections collection
    match /sections/{sectionId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Video Sections junction collection
    match /video_sections/{videoSectionId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Advertisements collection
    match /ads/{adId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Ad Settings collection
    match /ad_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Admin Accounts collection (PBKDF2 salted admin credentials) - NEVER ACCESSIBLE VIA CLIENT SDK
    match /admin_accounts/{docId} {
      allow read, write: if false;
    }
  }
}
